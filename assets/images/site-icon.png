<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <clipPath id="globe-clip">
      <circle cx="256" cy="256" r="236"/>
    </clipPath>
    <linearGradient id="ocean-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00a8b5"/>
      <stop offset="50%" stop-color="#12769d"/>
      <stop offset="100%" stop-color="#0e4d6c"/>
    </linearGradient>
  </defs>

  <!-- Outer Ring -->
  <circle cx="256" cy="256" r="248" fill="#e8edf0"/>

  <!-- Globe Ocean Base -->
  <circle cx="256" cy="256" r="236" fill="url(#ocean-grad)"/>

  <!-- Continents clipped inside globe -->
  <g clip-path="url(#globe-clip)">
    <!-- Ocean shade lines -->
    <path d="M120 0 C180 120 180 340 100 512 L0 512 L0 0 Z" fill="#0c4a68" opacity="0.45"/>
    <path d="M380 0 C440 180 430 380 320 512 L512 512 L512 0 Z" fill="#0095a8" opacity="0.35"/>

    <!-- North America (Green) -->
    <path d="M80 120 C100 90 140 85 180 105 C210 120 220 140 200 165 C180 185 160 170 140 185 C125 195 130 215 110 235 C95 245 90 260 85 270 C80 250 82 230 75 210 C70 190 75 150 80 120 Z" fill="#7bc843"/>
    <path d="M130 115 C150 95 185 90 205 110 C215 125 195 140 180 135 C165 130 150 145 135 135 Z" fill="#95d85c"/>
    <!-- Greenland -->
    <path d="M190 60 C210 50 240 55 245 75 C250 95 230 115 210 110 C195 105 185 80 190 60 Z" fill="#b2e578"/>

    <!-- South America (Brown/Warm) -->
    <path d="M105 270 C125 260 150 275 165 295 C185 320 195 345 180 375 C165 405 145 425 135 400 C125 380 115 340 105 310 C100 290 95 280 105 270 Z" fill="#c49658"/>
    <path d="M110 320 C125 315 155 325 165 350 C160 370 145 390 135 395 C125 375 118 345 110 320 Z" fill="#d9ad6f"/>

    <!-- Europe (Green) -->
    <path d="M225 140 C240 120 270 115 290 130 C305 140 300 165 285 175 C270 185 250 180 240 195 C230 190 220 160 225 140 Z" fill="#88cf50"/>
    <!-- Scandinavia / UK -->
    <path d="M260 85 C275 80 290 95 285 115 C275 125 260 115 260 85 Z" fill="#a4df70"/>

    <!-- Africa (Green Light) -->
    <path d="M215 215 C240 205 290 210 310 240 C325 260 305 285 300 310 C295 335 285 365 275 390 C265 400 250 370 245 340 C240 310 220 280 215 250 C210 235 210 225 215 215 Z" fill="#88cf50"/>
    <path d="M230 225 C250 215 280 225 295 245 C305 265 290 280 280 295 C270 305 255 285 245 265 C238 250 232 235 230 225 Z" fill="#9de066"/>

    <!-- Asia / Middle East (Pale Green) -->
    <path d="M295 130 C340 115 410 120 440 160 C460 185 450 235 430 270 C415 295 395 305 385 280 C375 255 355 240 335 230 C320 225 305 200 300 170 C295 150 290 140 295 130 Z" fill="#b0e6a5"/>
    <path d="M330 180 C370 165 415 175 425 210 C410 240 380 245 355 230 C340 220 330 200 330 180 Z" fill="#c3f0b8"/>

    <!-- India / South Asia -->
    <path d="M350 245 C370 245 385 265 375 295 C365 315 355 300 350 280 C345 265 345 255 350 245 Z" fill="#9de066"/>
  </g>
</svg>